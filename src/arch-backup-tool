#!/usr/bin/env python3
import sys
import os

# Add system installation paths to sys.path
sys.path.insert(0, "/usr/share/arch-backup-tool")
sys.path.insert(0, "/usr/local/share/arch-backup-tool")

# Also add the local folder for running in development mode
local_dir = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, local_dir)

try:
    from gui.main import main
except ImportError as e:
    print(f"Error: Could not import gui module. {e}", file=sys.stderr)
    print("If installed, ensure files are in /usr/share/arch-backup-tool/gui/ or /usr/local/share/arch-backup-tool/gui/", file=sys.stderr)
    sys.exit(1)

if __name__ == "__main__":
    main()
